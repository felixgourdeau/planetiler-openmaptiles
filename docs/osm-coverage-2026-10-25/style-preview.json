{
  "version": 8,
  "sources": {
    "basemap": {
      "type": "vector",
      "url": "https://example.com/tiles.json"
    }
  },
  "glyphs": "https://example.com/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "outmap-outdoor-areas",
      "type": "fill",
      "source": "basemap",
      "source-layer": "outdoor",
      "minzoom": 14,
      "filter": [
        "==",
        [
          "geometry-type"
        ],
        "Polygon"
      ],
      "paint": {
        "fill-color": "#5b6268",
        "fill-opacity": 0.09
      }
    },
    {
      "id": "outmap-outdoor-lines",
      "type": "line",
      "source": "basemap",
      "source-layer": "outdoor",
      "minzoom": 14,
      "paint": {
        "line-color": [
          "match",
          [
            "get",
            "class"
          ],
          "piste",
          "#5388b0",
          "whitewater",
          "#287da9",
          "via_ferrata",
          "#ad663d",
          "#5b6268"
        ],
        "line-width": 1.3,
        "line-opacity": 0.8
      }
    },
    {
      "id": "outmap-water-engineering",
      "type": "line",
      "source": "basemap",
      "source-layer": "waterway",
      "minzoom": 14,
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        [
          "literal",
          [
            "dam",
            "weir"
          ]
        ]
      ],
      "paint": {
        "line-color": "#5b6268",
        "line-width": 2.2
      }
    },
    {
      "id": "outmap-outdoor-names",
      "type": "symbol",
      "source": "basemap",
      "source-layer": "outdoor",
      "minzoom": 14,
      "filter": [
        "has",
        "name"
      ],
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "get",
          "name"
        ],
        "text-font": [
          "literal",
          [
            "Open Sans Regular"
          ]
        ],
        "text-size": 11
      },
      "paint": {
        "text-color": "#5b6268",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1
      }
    },
    {
      "id": "outmap-buildings-3d",
      "type": "fill-extrusion",
      "source": "basemap",
      "source-layer": "building",
      "minzoom": 14,
      "filter": [
        "all",
        [
          "!=",
          [
            "get",
            "hide_3d"
          ],
          true
        ],
        [
          "!=",
          [
            "get",
            "hide_3d"
          ],
          1
        ]
      ],
      "paint": {
        "fill-extrusion-height": [
          "coalesce",
          [
            "get",
            "render_height"
          ],
          0
        ],
        "fill-extrusion-base": [
          "coalesce",
          [
            "get",
            "render_min_height"
          ],
          0
        ],
        "fill-extrusion-color": [
          "coalesce",
          [
            "get",
            "colour"
          ],
          "#d4ccbd"
        ],
        "fill-extrusion-opacity": 0.9
      }
    },
    {
      "id": "outmap-marine-poi",
      "type": "symbol",
      "source": "basemap",
      "source-layer": "poi",
      "minzoom": 12,
      "filter": [
        "has",
        "marine_kind"
      ],
      "layout": {
        "icon-image": [
          "concat",
          "outmap-marine",
          "-",
          [
            "match",
            [
              "get",
              "marine_kind"
            ],
            [
              "seamark",
              "mooring"
            ],
            "marina",
            [
              "get",
              "marine_kind"
            ]
          ]
        ],
        "icon-size": 0.85,
        "icon-allow-overlap": false,
        "text-field": [
          "coalesce",
          [
            "get",
            "name"
          ],
          ""
        ],
        "text-font": [
          "Open Sans Regular"
        ],
        "text-size": 11,
        "text-offset": [
          0,
          1.3
        ],
        "text-anchor": "top",
        "text-optional": true,
        "text-allow-overlap": false,
        "symbol-sort-key": [
          "coalesce",
          [
            "get",
            "rank"
          ],
          1000
        ]
      },
      "paint": {
        "text-color": "#3e5b65",
        "text-halo-color": "#f5f3e8",
        "text-halo-width": 1.2
      }
    }
  ]
}
